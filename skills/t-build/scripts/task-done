#!/usr/bin/env bash
set -euo pipefail

# task-done start <tasks.md> <id>  run the proof before coding and log the result
# task-done <tasks.md> <id>        run the proof, tick the task on exit 0 and log it
#
# With context/agent/development/agentic-testing.md in the repo, a tick needs an
# earlier start line for the same command: red for a normal task, green for a
# task tagged refactor, whose proof must pass before and after.

mode=done
if [ "${1:-}" = "start" ]; then
  mode=start
  shift
fi

if [ "$#" -ne 2 ]; then
  echo "usage: task-done [start] <path/to/tasks.md> <task-id>" >&2
  exit 2
fi

if [ ! -f "$1" ]; then
  echo "task-done: no such file: $1" >&2
  exit 2
fi

tasks="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
id="$2"

case "$id" in
  "" | *[!A-Za-z0-9-]*)
    echo "task-done: bad task id: $id" >&2
    exit 2
    ;;
esac

line="$(grep -E "^- \[ \] ${id}[ :(]" "$tasks" | head -n 1 || true)"
if [ -z "$line" ]; then
  echo "task-done: no open task $id in $1" >&2
  exit 2
fi

cmd="$(printf '%s\n' "$line" | sed -n 's/.*Done when: `\(.*\)`[[:space:]]*$/\1/p')"
if [ -z "$cmd" ]; then
  echo "task-done: task $id has no Done when command in backticks" >&2
  exit 2
fi

refactor=no
if printf '%s\n' "$line" | grep -Eq "^- \[ \] ${id} \([^)]*refactor[^)]*\)"; then
  refactor=yes
fi

root="$(git -C "$(dirname "$tasks")" rev-parse --show-toplevel 2>/dev/null || dirname "$tasks")"
testing=no
if [ -f "$root/context/agent/development/agentic-testing.md" ]; then
  testing=yes
fi

log() {
  if ! grep -q '^## Log' "$tasks"; then
    printf '\n## Log\n' >> "$tasks"
  fi
  if [ -n "$(tail -c 1 "$tasks")" ]; then
    printf '\n' >> "$tasks"
  fi
  printf -- '- %s %s %s\n' "$(date +%Y-%m-%d)" "$id" "$1" >> "$tasks"
}

commit="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo no-commit)"
if [ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ]; then
  commit="$commit+dirty"
fi

if [ "$mode" = "done" ] && [ "$testing" = "yes" ]; then
  want="red"
  [ "$refactor" = "yes" ] && want="green"
  if ! grep -F -- " $id $want before: $cmd" "$tasks" > /dev/null; then
    echo "task-done: no '$want before' line for $id with this command. Run: task-done start $1 $id" >&2
    exit 2
  fi
fi

cd "$root"
echo "task-done: $id: running $cmd"
set +e
bash -c "$cmd" < /dev/null
code=$?
set -e

if [ "$mode" = "start" ]; then
  if [ "$refactor" = "yes" ]; then
    if [ "$code" -ne 0 ]; then
      echo "task-done: $id is a refactor, so its proof must pass before the change; it exited $code" >&2
      exit 1
    fi
    log "green before: $cmd"
    echo "task-done: $id passes before the refactor, as it should"
  else
    if [ "$code" -eq 0 ]; then
      echo "task-done: $id passes before any work, so it proves nothing yet. Make the proof test the new behaviour." >&2
      exit 1
    fi
    log "red before: $cmd"
    echo "task-done: $id fails before the work, as it should"
  fi
  exit 0
fi

if [ "$code" -ne 0 ]; then
  echo "task-done: $id not done, command exited $code" >&2
  exit "$code"
fi

tmp="$(mktemp)"
awk -v id="$id" '
  !ticked && $0 ~ ("^- \\[ \\] " id "[ :(]") { sub(/^- \[ \] /, "- [x] "); ticked = 1 }
  { print }
' "$tasks" > "$tmp"
cat "$tmp" > "$tasks"
rm -f "$tmp"

log "$commit pass: $cmd"
echo "task-done: ticked $id"
